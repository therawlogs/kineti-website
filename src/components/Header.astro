---
const nav = [
  { href: "/docs/getting-started", label: "Docs" },
  { href: "/benchmarks", label: "Benchmarks" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  path === href || (href === "/docs/getting-started" && path.startsWith("/docs"));
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/90 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 sm:flex-nowrap sm:gap-y-0 sm:px-6 sm:py-0 sm:h-[53px]">
    <a href="/" class="flex shrink-0 items-center gap-2 whitespace-nowrap">
      <span class="text-base font-bold tracking-widest text-fg">KINETI</span>
      <span class="rounded-none border border-line bg-surface-2 px-2 py-0.5 text-xs leading-none text-accent">v0.1.0</span>
    </a>

    <nav class="order-3 w-full sm:order-none sm:w-auto sm:flex-1" aria-label="Main">
      <ul class="flex items-center gap-6 text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "transition-colors",
                  isActive(item.href) ? "text-accent" : "text-muted hover:text-fg",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <button
        type="button"
        data-copy-install
        class="rounded-none border border-line bg-surface px-3 py-1.5 text-xs text-fg transition-colors hover:border-accent"
        title="Copy install command to clipboard"
      >
        <span data-copy-label>Copy Install</span>
      </button>
      <a
        href="https://github.com/therawlogs/kineti"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-none border border-line bg-surface px-3 py-1.5 text-xs text-fg transition-colors hover:border-accent"
      >
        Source
      </a>
    </div>
  </div>
</header>
