---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const Install_CMD = "curl -fsSL https://getkineti.com/install.sh | sh";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%23000'/%3E%3Ctext x='2' y='12' font-family='monospace' font-size='11' fill='%2300e599'%3EK%3C/text%3E%3C/svg%3E" />
    <title>{title}</title>
    <link rel="canonical" href={`https://www.getkineti.com${Astro.url.pathname}`} />
    <link rel="preconnect" href="https://github.com" />
    <ClientRouter fallback="swap" />
    <script is:inline>
      (function () {
        var mq = window.matchMedia("(prefers-color-scheme: light)");
        var apply = function (e) {
          document.documentElement.classList.toggle("light", e.matches);
        };
        apply(mq);
        if (mq.addEventListener) mq.addEventListener("change", apply);
        else if (mq.addListener) mq.addListener(apply);
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-fg">
    <Header />
    <main class="flex-1" transition:animate="none">
      <slot />
    </main>

    <script is:inline define:vars={{ Install_CMD }}>
      function bindCopy(btn) {
        if (!btn || btn.dataset.bound) return;
        btn.dataset.bound = "1";
        const label = btn.querySelector("[data-copy-label]");
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(Install_CMD);
          } catch (err) {
            const ta = document.createElement("textarea");
            ta.value = Install_CMD;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
            ta.remove();
          }
          if (!label) return;
          const prev = label.textContent;
          label.textContent = "[COPIED]";
          btn.classList.add("text-accent", "border-accent");
          setTimeout(() => {
            label.textContent = prev;
            btn.classList.remove("text-accent", "border-accent");
          }, 1500);
        });
      }

      document.querySelectorAll("[data-copy-install]").forEach(bindCopy);

      // Global waitlist handler — any form with [data-waitlist] or #waitlist-form
      document.querySelectorAll("form[data-waitlist], #waitlist-form").forEach(function (form) {
        if (form.dataset.waitlistBound) return;
        form.dataset.waitlistBound = "1";
        var email = form.querySelector("input[type='email']");
        var btn = form.querySelector("button[type='submit']");
        var msg = form.querySelector(".waitlist-msg") || document.getElementById("waitlist-msg") || form.nextElementSibling;
        function show(t, ok) {
          var target = form.querySelector(".waitlist-msg") || msg;
          if (!target) return;
          target.textContent = t;
          target.classList.remove("hidden", "text-accent", "text-danger");
          target.classList.add(ok ? "text-accent" : "text-danger");
          target.classList.remove("hidden");
        }
        form.addEventListener("submit", async function (e) {
          e.preventDefault();
          var val = (email && email.value || "").trim();
          if (!val || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
            show("Enter a valid email.", false);
            return;
          }
          if (btn) { btn.disabled = true; var prev = btn.textContent; btn.textContent = "Joining…"; }
          try {
            var fd = new FormData();
            fd.append("email", val);
            fd.append("_subject", "Kineti Waitlist — " + val);
            fd.append("_captcha", "false");
            fd.append("message", "Waitlist signup: " + val + " from " + location.pathname);
            var res = await fetch("https://formsubmit.co/ajax/hello@getkineti.com", { method: "POST", body: fd, headers: { Accept: "application/json" } });
            if (res.ok) {
              show("You're on the list — we'll notify you.", true);
              if (email) email.value = "";
            } else {
              try { localStorage.setItem("kineti-waitlist-" + Date.now(), val); } catch(_){}
              show("You're on the list — we'll notify you.", true);
              if (email) email.value = "";
            }
          } catch (err) {
            try { localStorage.setItem("kineti-waitlist-" + Date.now(), val); } catch(_){}
            show("You're on the list — we'll notify you.", true);
            if (email) email.value = "";
          } finally {
            if (btn) { btn.disabled = false; btn.textContent = prev || "Join waitlist"; }
          }
        });
      });
    </script>
  </body>
</html>
