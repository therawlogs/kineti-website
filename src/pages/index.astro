---
import BaseLayout from "../layouts/BaseLayout.astro";
import Terminal from "../components/Terminal.astro";
---

<BaseLayout
  title="Ship proof and spend cap for any agent · Kineti"
  description="Ship proof and spend cap for any agent — code, docs, data, configs. Claude, Cursor, Grok, and fx produce artifacts. Kineti binds any verification to hashes, caps the bill, and fails merge if the proof is stale."
>
  <!-- HERO -->
  <section class="border-b border-line">
    <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 lg:px-8 sm:py-12">
      <h1 class="max-w-3xl text-3xl font-bold leading-tight tracking-tight text-fg sm:text-5xl">
        Ship proof and spend cap for any agent.
      </h1>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted sm:text-base">
        Claude, Cursor, Grok, and fx produce artifacts — code, docs, data, configs. Kineti binds <em class="text-fg not-italic">any</em> verification to artifact hashes, caps the bill, and fails merge if the proof is stale.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <button
          type="button"
          data-copy-install
          class="rounded-none border border-accent bg-surface-2 px-4 py-2 text-sm font-bold text-accent transition-colors hover:bg-surface"
        >
          <span data-copy-label>Copy install</span>
        </button>
        <a
          href="https://github.com/therawlogs/kineti"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-none border border-line bg-surface px-4 py-2 text-sm text-fg transition-colors hover:border-accent"
          >Source</a
        >
        <a
          href="/docs/getting-started"
          class="rounded-none border border-line bg-surface px-4 py-2 text-sm text-fg transition-colors hover:border-accent"
          >Docs</a
        >
      </div>

      <div class="mt-8 max-w-2xl">
        <Terminal />
      </div>

      <div class="mt-6 max-w-2xl">
        <pre class="overflow-x-auto rounded-none border border-line bg-surface px-5 py-4 text-xs leading-relaxed sm:text-sm"><code><span class="font-bold text-fg">kineti init</span>
<span class="font-bold text-fg">kineti evidence --cmd "cargo test"</span>  <span class="text-muted"># or pytest / npm test / ./verify.sh</span>
<span class="font-bold text-fg">kineti swarm --tasks tasks.jsonl --cap 10</span>  <span class="text-muted"># one cmd, N agents</span>
<span class="font-bold text-fg">kineti ship-check</span></code></pre>
        <div class="mt-3 flex items-center justify-between rounded-none border border-line bg-surface-2 px-4 py-3 text-xs sm:text-sm">
          <span class="text-muted">Artifacts changed after evidence</span>
          <span class="font-bold text-danger">→ ship-check exit 1</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ONE TABLE -->
  <section class="border-b border-line">
    <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 lg:px-8 sm:py-12">
      <h2 class="text-xs tracking-wide text-muted">What it enforces</h2>
      <div class="mt-8 overflow-x-auto border border-line">
        <table class="w-full min-w-[560px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-line bg-surface-2 text-xs tracking-wide text-muted">
              <th scope="col" class="px-4 py-3 font-normal">If this happens</th>
              <th scope="col" class="px-4 py-3 font-normal">Kineti</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-line transition-colors hover:bg-surface-2">
              <td class="px-4 py-3 text-muted">Verification ran on old artifacts</td>
              <td class="px-4 py-3 font-bold text-danger">Ship refused</td>
            </tr>
            <tr class="border-b border-line transition-colors hover:bg-surface-2">
              <td class="px-4 py-3 text-muted">Spend over cap (any agent via gateway/wrap/swarm)</td>
              <td class="px-4 py-3 font-bold text-danger">Run stops until a human reset file</td>
            </tr>
            <tr class="border-b border-line transition-colors hover:bg-surface-2">
              <td class="px-4 py-3 text-muted">Artifacts changed after proof</td>
              <td class="px-4 py-3 font-bold text-danger">Stale — re-run proof</td>
            </tr>
            <tr class="transition-colors hover:bg-surface-2">
              <td class="px-4 py-3 text-muted">Journal byte flipped</td>
              <td class="px-4 py-3 font-bold text-danger"><code class="text-accent">verify</code> fails</td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
  </section>

</BaseLayout>
