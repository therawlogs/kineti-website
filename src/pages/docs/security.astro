---
import DocsLayout from "../../layouts/DocsLayout.astro";

const toc = [
  { id: "sec-report", label: "01 Report a problem" },
  { id: "sec-scope", label: "02 What is in scope (v0.2.2)" },
  { id: "sec-limits", label: "03 Honest limits (v0.2.2)" },
  { id: "sec-legacy-limits", label: "04 Legacy limits (v0.1)" },
];

const scope = [
  "Path-fence escapes (tools escaping the project root, symlink tricks)",
  "Prompt-injection paths that lead to tool execution from untrusted content",
  "Hash-chain verification bypasses (tampered evidence.json / journals verifying as OK)",
  "Spend breaker bypasses (reservation races, ledger-lock contention, .kineti/spend.reset bypass)",
  "Daemon IPC attacks: .kineti/kineti.sock must stay 0600",
  "OAuth token theft: ~/.kineti/auth/* must stay 0600 and never leak into logs or child env",
  "Egress hash-chain tampering (receipt chain broken but verify --all passes)",
  "Worktree teardown path traversal: destroy() refusing anything outside .kineti/worktrees/<id> (legacy swarm, still in tree)",
];

const limitations = [
  {
    title: "Shell has your user permissions",
    body: "bash (via evidence --cmd, wrap, or swarm tasks) runs with your user permissions inside the project directory; there is no syscall sandbox yet (planned: platform sandbox profiles). Blast radius is bounded by [artifacts] scope partitioning + ship-check refusing stale proofs, not by the kernel.",
  },
  {
    title: "Gateway sees prompts in memory",
    body: "Gateway + swarm/wrap are stateless workers + one ledger per org; receipts store fingerprint, chain_head, cost_usd, cmd, passed — never raw prompts (hashes + counts only). A compromised gateway worker sees prompts in memory while forwarding.",
  },
  {
    title: "Verify trusts local files",
    body: "verify and ship-check are offline and trust local files; a fully compromised host can rewrite .kineti/evidence.json and .kineti/journal.jsonl before verification.",
  },
  {
    title: "Tokens depend on your account safety",
    body: "OAuth tokens on disk are only as safe as the user account that owns them; a fully compromised host reads them like any other secret.",
  },
  {
    title: "Daemon socket is same-user only",
    body: "The daemon socket is 0600 (same user only). It is not protection against malware running as your user.",
  },
  {
    title: "Network is not blocked",
    body: "Network access of spawned processes is not restricted.",
  },
];

const legacyLimitations = [
  {
    title: "Swarm workers unfenced in worktrees",
    body: "Swarm workers' bash is likewise unfenced INSIDE their worktrees — isolation is via worktree directories + git-based integration, not the kernel.",
  },
  {
    title: "Quarantine is heuristic",
    body: "Quarantine is heuristic pattern-matching, not true dual-model isolation.",
  },
];
---

<DocsLayout
  title="Security — Kineti"
  description="How to report problems, what is in scope, and what is not yet fully covered. Use this to decide if Kineti fits your risk."
  active="security"
  {toc}
>
  <section data-doc-section class="scroll-mt-20 border-b border-line py-10">
    <h1 class="text-xl font-bold tracking-tight text-fg sm:text-2xl">Security</h1>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">
      Copied from <code class="text-accent">SECURITY.md</code> in the repo. The repo is the source of truth.
    </p>
  </section>

  <section id="sec-report" data-doc-section aria-labelledby="h-report" class="scroll-mt-20 border-b border-line py-10">
    <h2 id="h-report" class="text-sm font-bold tracking-wide text-fg"><span class="mr-2 text-accent">01</span>Report a problem</h2>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">
      Tell us privately on GitHub
      <a
        href="https://github.com/therawlogs/kineti/security/advisories/new"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent hover:underline">Security Advisories</a
      >. Do not open a public issue for a flaw that can be used to attack. We reply within 7 days.
    </p>
  </section>

  <section id="sec-scope" data-doc-section aria-labelledby="h-scope" class="scroll-mt-20 border-b border-line py-10">
    <h2 id="h-scope" class="text-sm font-bold tracking-wide text-fg"><span class="mr-2 text-accent">02</span>What is in scope <span class="text-muted">(v0.2.2)</span></h2>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">
      Kineti v0.2.2 is a ship proof + spend fuse for <strong class="text-fg">any agent</strong> — code, docs, data, configs. In scope:
    </p>
    <ul class="mt-6 max-w-3xl list-disc space-y-3 pl-5 text-sm leading-relaxed text-muted marker:text-accent">
      {scope.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section id="sec-limits" data-doc-section aria-labelledby="h-limits" class="scroll-mt-20 border-b border-line py-10">
    <h2 id="h-limits" class="text-sm font-bold tracking-wide text-fg"><span class="mr-2 text-accent">03</span>Honest limits <span class="text-muted">(v0.2.2)</span></h2>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">We list these up front so you can decide:</p>
    <ul class="mt-6 max-w-3xl space-y-4">
      {
        limitations.map((item) => (
          <li class="border-l-2 border-line pl-4 text-sm leading-relaxed text-muted transition-colors hover:border-accent">
            <strong class="text-fg">{item.title}</strong> — {item.body}
          </li>
        ))
      }
    </ul>
    <p class="mt-8 max-w-3xl border-l-2 border-danger bg-surface px-4 py-3 text-sm font-bold leading-relaxed text-fg">
      Treat Kineti as blast-radius reduction and audit infrastructure — not as a hard security boundary against a fully compromised host.
    </p>
  </section>

  <section id="sec-legacy-limits" data-doc-section aria-labelledby="h-legacy-limits" class="scroll-mt-20 py-10">
    <h2 id="h-legacy-limits" class="text-sm font-bold tracking-wide text-fg"><span class="mr-2 text-accent">04</span>Legacy limits <span class="text-muted">(v0.1, frozen)</span></h2>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">These apply only to the frozen 13-stage runner (<code class="text-accent">kineti run --legacy</code>, <code class="text-accent">docs/v0.1.md</code>, tag <code class="text-accent">v0.1.0</code>):</p>
    <ul class="mt-6 max-w-3xl space-y-4">
      {
        legacyLimitations.map((item) => (
          <li class="border-l-2 border-line pl-4 text-sm leading-relaxed text-muted transition-colors hover:border-accent">
            <strong class="text-fg">{item.title}</strong> — {item.body}
          </li>
        ))
      }
    </ul>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">Same worktree teardown, network, and token caveats as above.</p>
    <p class="mt-8 text-sm leading-relaxed text-muted">
      Next: <a href="/docs/architecture" class="text-accent hover:underline">Architecture</a> ·
      <a href="/docs/governance" class="text-accent hover:underline">Governance</a> ·
      <a href="/docs/changelog" class="text-accent hover:underline">Changelog</a>
    </p>
  </section>
</DocsLayout>
