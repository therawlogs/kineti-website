---
import DocsLayout from "../../layouts/DocsLayout.astro";

const toc = [
  { id: "sec-commands", label: "01 Commands" },
  { id: "sec-env", label: "02 Environment flags" },
  { id: "sec-exit", label: "03 Exit codes" },
];

const commands = [
  { cmd: "init", purpose: "Create .kineti folder and kineti.toml in this folder" },
  {
    cmd: "run --goal … [--provider …] [--model …] [--cap …] [--mode …]",
    purpose: "Run the 13 steps on your goal. --cap sets spend limit. --mode picks one worker or many.",
  },
  {
    cmd: "task --task … [--provider …] [--model …]",
    purpose: "Run one task with checks (no 13 steps)",
  },
  { cmd: "resume [--provider …] [--model …]", purpose: "Continue from the last saved step" },
  { cmd: "undo", purpose: "Undo file changes, newest first" },
  {
    cmd: "evidence --cmd …",
    purpose: "Run a check command and link the result to the current code",
  },
  { cmd: "ship-check", purpose: "Check if proof matches current code (ship gate check)" },
  {
    cmd: "verify [--all]",
    purpose: "Check the log hash chain and show the last hash; --all checks all branches and orphans",
  },
  {
    cmd: "clean-check",
    purpose: "Check project files for names, home paths, or secrets — must be zero",
  },
  {
    cmd: "merge --branch <id>",
    purpose: "Join a worker log into the main log with a two-parent record",
  },
  {
    cmd: "login --provider <p>",
    purpose: "Sign in with OAuth (opens browser, waits on local address)",
  },
  { cmd: "logout --provider <p>", purpose: "Remove a saved OAuth token" },
  { cmd: "auth-status", purpose: "Show saved tokens and when they expire" },
  { cmd: "serve [--foreground]", purpose: "Run the background daemon on .kineti/kineti.sock" },
  {
    cmd: "receipt [--last]",
    purpose: "Show summary: spend, gate steps, log state, sends, and file checks",
  },
  {
    cmd: "provider-test --provider <p> [--model …]",
    purpose: "Send a small test to a provider to check the connection",
  },
];

const envFlags = [
  { key: "KINETI_FORCE_DIRECT=1", effect: "Skip the daemon even if one is running" },
  { key: "KINETI_NO_DAEMON=1", effect: "Never start or use a daemon" },
  { key: "KINETI_Install_DIR", effect: "Change where install.sh puts the binary" },
];
---

<DocsLayout
  title="CLI reference — Kineti"
  description="Every kineti command, env flag, and exit code — one binary, no extra parts."
  active="cli"
  {toc}
>
  <!-- INTRO -->
  <section data-doc-section class="scroll-mt-20 border-b border-line py-10">
    <h1 class="text-xl font-bold tracking-tight text-fg sm:text-2xl">CLI reference</h1>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">
      <code class="text-accent">kineti &lt;command&gt;</code> — one binary, no extra parts. The version comes from the
      release tag.
    </p>
  </section>

  <!-- 1. Commands -->
  <section id="sec-commands" data-doc-section aria-labelledby="h-commands" class="scroll-mt-20 border-b border-line py-10">
    <h2 id="h-commands" class="text-sm font-bold tracking-wide text-fg"><span class="mr-2 text-accent">01</span>Commands</h2>
    <div class="mt-6 overflow-x-auto border border-line">
      <table class="w-full min-w-[720px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-line bg-surface-2 text-xs tracking-wide text-muted">
            <th scope="col" class="px-4 py-3 font-normal">COMMAND</th>
            <th scope="col" class="px-4 py-3 font-normal">PURPOSE</th>
          </tr>
        </thead>
        <tbody>
          {
            commands.map((c) => (
              <tr class="border-b border-line transition-colors last:border-b-0 hover:bg-surface-2">
                <td class="px-4 py-3 font-bold whitespace-nowrap text-accent">{c.cmd}</td>
                <td class="px-4 py-3 leading-relaxed text-muted">{c.purpose}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- 2. Environment flags -->
  <section id="sec-env" data-doc-section aria-labelledby="h-env" class="scroll-mt-20 border-b border-line py-10">
    <h2 id="h-env" class="text-sm font-bold tracking-wide text-fg"><span class="mr-2 text-accent">02</span>Environment flags</h2>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">Flags that change how the binary runs:</p>
    <div class="mt-6 overflow-x-auto border border-line">
      <table class="w-full min-w-[560px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-line bg-surface-2 text-xs tracking-wide text-muted">
            <th scope="col" class="px-4 py-3 font-normal">ENV VAR</th>
            <th scope="col" class="px-4 py-3 font-normal">EFFECT</th>
          </tr>
        </thead>
        <tbody>
          {
            envFlags.map((f) => (
              <tr class="border-b border-line transition-colors last:border-b-0 hover:bg-surface-2">
                <td class="px-4 py-3 font-bold whitespace-nowrap text-accent">{f.key}</td>
                <td class="px-4 py-3 leading-relaxed text-muted">{f.effect}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- 3. Exit codes -->
  <section id="sec-exit" data-doc-section aria-labelledby="h-exit" class="scroll-mt-20 py-10">
    <h2 id="h-exit" class="text-sm font-bold tracking-wide text-fg"><span class="mr-2 text-accent">03</span>Exit codes</h2>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">
      <code class="text-accent">0</code> ok ·
      <code class="text-danger">1</code> stopped, changed log, dirty files, or refused — commands stop on error.
    </p>
  </section>
</DocsLayout>
