---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Row {
  model: string;
  provider: string;
  providerFilter: string;
  pass: string;
  passNum: number;
  cost: string;
  latency: string;
  proofShort: string;
  proofUrl: string;
}

const REPO = "https://github.com/therawlogs/kineti/blob/main/benchmarks";

const rows: Row[] = [
  {
    model: "claude-3.7-sonnet",
    provider: "OpenRouter",
    providerFilter: "openrouter",
    pass: "96.0%",
    passNum: 96,
    cost: "$0.048",
    latency: "9.1 µs",
    proofShort: "7d10ab...3311",
    proofUrl: `${REPO}/claude-3.7-sonnet.json`,
  },
  {
    model: "gemini-3.6-flash",
    provider: "Google",
    providerFilter: "google",
    pass: "94.0%",
    passNum: 94,
    cost: "$0.000 (Free Tier)",
    latency: "7.8 µs",
    proofShort: "9f8a12...c41e",
    proofUrl: `${REPO}/gemini-3.6-flash.json`,
  },
  {
    model: "grok-4",
    provider: "xAI",
    providerFilter: "xai",
    pass: "91.0%",
    passNum: 91,
    cost: "$0.014",
    latency: "8.4 µs",
    proofShort: "e3ea14...12a4",
    proofUrl: `${REPO}/grok-4.json`,
  },
  {
    model: "llama-3.3-70b",
    provider: "Ollama (Local)",
    providerFilter: "ollama",
    pass: "86.0%",
    passNum: 86,
    cost: "$0.000 (Local)",
    latency: "6.9 µs",
    proofShort: "44b201...99ef",
    proofUrl: `${REPO}/llama-3.3-70b.json`,
  },
];

const filters = [
  { key: "all", label: "ALL" },
  { key: "google", label: "Google" },
  { key: "xai", label: "xAI" },
  { key: "openrouter", label: "OpenRouter" },
  { key: "ollama", label: "Ollama" },
];
---

<BaseLayout
  title="Benchmarks — Kineti"
  description="Each model does the same 100 code tasks in 13 steps. Each row links to a proof file you can open and check."
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h1 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">Benchmarks</h1>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">
        Each model does the same 100 code tasks in 13 steps. Results stay on your computer.
        Each row links to a proof file you can open.
      </p>
    </div>
  </section>

  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by provider" id="provider-filters">
        <span class="mr-2 text-xs tracking-widest text-muted">FILTER:</span>
        {
          filters.map((f, i) => (
            <button
              type="button"
              data-filter={f.key}
              aria-pressed={i === 0 ? "true" : "false"}
              class:list={[
                "rounded-none border px-3 py-1 text-xs transition-colors",
                i === 0
                  ? "border-accent bg-surface-2 text-accent"
                  : "border-line bg-surface text-muted hover:border-muted",
              ]}
            >
              {f.label}
            </button>
          ))
        }
      </div>

      <div class="mt-6 overflow-x-auto border border-line">
        <table class="w-full min-w-[760px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-line bg-surface-2 text-xs tracking-widest text-muted">
              <th scope="col" class="px-4 py-3 font-normal">#</th>
              <th scope="col" class="px-4 py-3 font-normal">MODEL</th>
              <th scope="col" class="px-4 py-3 font-normal">PROVIDER</th>
              <th scope="col" class="px-4 py-3 font-normal">PASSED</th>
              <th scope="col" class="px-4 py-3 font-normal">COST PER TASK</th>
              <th scope="col" class="px-4 py-3 font-normal">TIME</th>
              <th scope="col" class="px-4 py-3 font-normal">PROOF (HASH)</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r, i) => (
                <tr
                  data-provider={r.providerFilter}
                  class="benchmark-row border-b border-line transition-colors last:border-b-0 hover:bg-surface-2"
                >
                  <td class="px-4 py-3 text-xs text-muted">{String(i + 1).padStart(2, "0")}</td>
                  <td class="px-4 py-3 font-bold text-fg">{r.model}</td>
                  <td class="px-4 py-3 text-muted">{r.provider}</td>
                  <td class="px-4 py-3">
                    <span class="font-bold text-accent">{r.pass}</span>
                    <span class="mt-1 block h-1 w-24 bg-line">
                      <span class="block h-1 bg-accent" style={`width:${r.passNum}%`} />
                    </span>
                  </td>
                  <td class:list={["px-4 py-3", r.cost.startsWith("$0") ? "text-accent" : "text-fg"]}>{r.cost}</td>
                  <td class="px-4 py-3 text-fg">{r.latency}</td>
                  <td class="px-4 py-3">
                    <a href={r.proofUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline" title={`Raw JSON receipt: ${r.proofUrl}`}>
                      {r.proofShort}
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p id="no-results" hidden class="mt-4 text-sm text-danger">[NO MATCHING ROWS]</p>
    </div>
  </section>

  <!-- VERIFY IT YOURSELF -->
  <section>
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="text-xs tracking-widest text-muted"><span class="text-accent">##</span> CHECK YOURSELF</h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted">
        The test set is open. Run the same 100 tasks, then compare your final hash with the one
        shown here. If the hashes match, the results match.
      </p>
      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-none border border-line bg-surface p-5">
          <p class="text-xs tracking-widest text-accent">STEP_01</p>
          <h3 class="mt-2 font-bold text-fg">Get the tests</h3>
          <pre class="mt-3 whitespace-pre-wrap break-words text-xs text-muted"><code>git clone https://github.com/therawlogs/kineti
cd kineti/benchmarks</code></pre>
        </div>
        <div class="rounded-none border border-line bg-surface p-5">
          <p class="text-xs tracking-widest text-accent">STEP_02</p>
          <h3 class="mt-2 font-bold text-fg">Run the 100 tasks</h3>
          <pre class="mt-3 whitespace-pre-wrap break-words text-xs text-muted"><code>kineti run --suite refactoring-100 \
  --model claude-3.7-sonnet</code></pre>
        </div>
        <div class="rounded-none border border-line bg-surface p-5">
          <p class="text-xs tracking-widest text-accent">STEP_03</p>
          <h3 class="mt-2 font-bold text-fg">Compare the final hash</h3>
          <pre class="mt-3 whitespace-pre-wrap break-words text-xs text-muted"><code>kineti verify --all
# Final hash: 7d10ab... (VERIFIED)</code></pre>
        </div>
      </div>
      <p class="mt-6 max-w-3xl text-xs leading-relaxed text-muted">
        Proof files never leave your computer. The links above are JSON files in the repo.
        Compare them with your own <code class="text-accent">journal.jsonl</code>.
      </p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const group = document.getElementById("provider-filters");
      const rowEls = Array.from(document.querySelectorAll(".benchmark-row"));
      const empty = document.getElementById("no-results");
      if (!group || !empty) return;
      const buttons = Array.from(group.querySelectorAll("[data-filter]"));
      function select(key) {
        let visible = 0;
        for (const btn of buttons) {
          const active = btn.dataset.filter === key;
          btn.setAttribute("aria-pressed", active ? "true" : "false");
          btn.classList.toggle("border-accent", active);
          btn.classList.toggle("bg-surface-2", active);
          btn.classList.toggle("text-accent", active);
          btn.classList.toggle("border-line", !active);
          btn.classList.toggle("bg-surface", !active);
          btn.classList.toggle("text-muted", !active);
        }
        for (const row of rowEls) {
          const show = key === "all" || row.dataset.provider === key;
          row.hidden = !show;
          if (show) visible++;
        }
        empty.hidden = visible > 0;
      }
      for (const btn of buttons) {
        btn.addEventListener("click", () => select(btn.dataset.filter));
      }
    })();
  </script>
</BaseLayout>
